<?xml version="1.0" encoding="utf-8"?>
<!--
    Medical Marketplace : Vendor / Supplier Partners
    =================================================
    Creates 6 pre-verified B2B supplier companies (one per product category).
-->
<odoo noupdate="1">

    <!-- 1. DiagnoTech Instruments -->
    <record id="vendor_diagnotech" model="res.partner">
        <field name="name">DiagnoTech Instruments Ltd.</field>
        <field name="is_company" eval="True"/>
        <field name="email">procurement@diagnotech.com</field>
        <field name="registration_number">DT-MED-20145</field>
        <field name="verification_status">verified</field>
        <field name="is_verified" eval="True"/>
    </record>

