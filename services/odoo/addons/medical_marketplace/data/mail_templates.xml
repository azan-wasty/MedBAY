<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Notification sent to buyer when RFQ is quoted by admin -->
        <record id="email_template_rfq_quoted" model="mail.template">
            <field name="name">RFQ Quoted Notification</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Your RFQ {{ object.name or 'N/A' }} has been quoted</field>
            <field name="email_from">{{ (object.company_id.email or user.email or '') }}</field>
            <field name="email_to">{{ (object.partner_id.email or '') }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333; line-height: 1.5;">
                    <p>Dear {{ object.partner_id.name or 'Valued Customer' }},</p>
                    <p>
                        Your request for quotation <strong>{{ object.name or 'N/A' }}</strong> for company 
                        <strong>{{ (object.partner_id.commercial_partner_id.name or object.company_id.name or 'N/A') }}</strong>
                        has been reviewed and priced by our team.
                    </p>
                    <p>
                        <strong>Total Amount:</strong>
                        {{ '%.2f' % (object.amount_total or 0.0) }} {{ (object.currency_id.symbol or '$') }}
                    </p>
                    <p>Please log in to your account to review the quotation and confirm your order.</p>
                    <p>Thank you,<br/>The Marketplace Team</p>
                </div>
            </field>
        </record>

        <!-- Notification sent when company account is verified -->
        <record id="email_template_partner_verified" model="mail.template">
            <field name="name">Company Verification Approved</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Your company account {{ object.name or 'N/A' }} has been verified — you can now submit quotes</field>
            <field name="email_from">{{ (user.email or object.company_id.email or '') }}</field>
            <field name="email_to">{{ (object.email or '') }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333; line-height: 1.5;">
                    <p>Dear {{ object.name or 'Valued Customer' }},</p>
                    <p>
                        Great news — your company account <strong>{{ (object.commercial_company_name or object.name or 'N/A') }}</strong> on the Medical Marketplace has been
                        <strong style="color: #0F7A6C;">verified</strong>.
                    </p>
                    <p>
                        You can now log in and submit Requests for Quotation (RFQs) for any products in our catalog.
                    </p>
                    <p>
                        <a href="/" style="color: #0F7A6C; font-weight: bold; text-decoration: none;">Browse the Catalog &rarr;</a>
                    </p>
                    <p>Thank you,<br/>The Marketplace Team</p>
                </div>
            </field>
        </record>
    </data>
</odoo>