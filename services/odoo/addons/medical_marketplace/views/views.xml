<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product form: Medical B2B fields + publish toggle + sourcing company -->
    <record id="product_template_only_form_view_medical" model="ir.ui.view">
        <field name="name">product.template.product.form.medical</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Medical Equipment B2B Specs">
                    <field name="certification_info"/>
                    <field name="unit_of_measure"/>
                    <field name="min_order_qty"/>
                    <field name="warranty_period"/>
                </group>
                <group string="B2B Vendor Company">
                    <field name="has_vendor_company"/>
                    <field name="vendor_id" invisible="not has_vendor_company"/>
                    <field name="seller_ids" invisible="not has_vendor_company"/>
                </group>

                <group string="Stock">
                    <field name="type"/>
                    <field name="qty_available"/>
                    <field name="low_stock_threshold"/>
                    <field name="stock_status" widget="badge"
                           decoration-success="stock_status == 'in_stock'"
                           decoration-warning="stock_status == 'low_stock'"
                           decoration-danger="stock_status == 'out_of_stock'"/>
                </group>
                <group string="Marketplace">
                    <field name="marketplace_published" widget="boolean_toggle"/>
                    <field name="marketplace_featured" widget="boolean_toggle"/>
                    <field name="featured_sequence"
                           invisible="not marketplace_featured"
                           string="Featured Display Order"
                           help="Lower number = displayed earlier in the hero carousel. Default: 10"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Sale order line: show buyer's proposed target price (bid) in FORM inline tree -->
    <record id="view_sale_order_form_medical_target_price" model="ir.ui.view">
        <field name="name">sale.order.form.medical.target_price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insert "Buyer Target Price" column right after the unit price column -->
            <xpath expr="//field[@name='order_line']//tree//field[@name='price_unit']" position="after">
                <field name="target_price_unit"
                       string="Buyer Target Price"
                       optional="show"
                       widget="monetary"
                       invisible="target_price_unit == 0"
                       help="The unit price the buyer proposed when submitting the RFQ. 0 means no target was specified."/>
            </xpath>
        </field>
    </record>

    <!-- Sale order line standalone list view: target price column removed.
         sale.view_order_line_tree in Odoo 17 does not expose price_unit,
         so the xpath anchor no longer exists. The buyer target price is
         already visible in the order form view (view_sale_order_form_medical_target_price above). -->

    <!-- ================================================================
         Marketplace Admin: Company Verification list view + search + menu
         ================================================================ -->

    <!-- List view: res.partner with verification columns -->
    <record id="view_partner_verification_list" model="ir.ui.view">
        <field name="name">res.partner.verification.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Companies" default_order="create_date desc">
                <field name="name" string="Organization"/>
                <field name="email"/>
                <field name="registration_number" string="Reg. Number"/>
                <field name="verification_status" widget="badge"
                       decoration-success="verification_status == 'verified'"
                       decoration-warning="verification_status == 'pending'"
                       decoration-danger="verification_status == 'rejected'"/>
                <field name="verification_date" string="Verified On" optional="show"/>
                <field name="verified_by" string="Verified By" optional="show"/>
                <field name="create_date" string="Registered" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Search view: filter by verification status -->
    <record id="view_partner_verification_search" model="ir.ui.view">
        <field name="name">res.partner.verification.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Company Verification">
                <field name="name" string="Organization"/>
                <field name="email"/>
                <field name="registration_number"/>
                <separator/>
                <filter name="pending" string="Pending Review"
                        domain="[('verification_status','=','pending')]"/>
                <filter name="verified" string="Verified"
                        domain="[('verification_status','=','verified')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('verification_status','=','rejected')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'verification_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: always pre-filtered to is_company=True buyer partners -->
    <record id="action_partner_verification" model="ir.actions.act_window">
        <field name="name">Company Verification</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_partner_verification_list"/>
        <field name="search_view_id" ref="view_partner_verification_search"/>
        <!-- Default to pending so admins see the work queue immediately -->
        <field name="domain">[('is_company','=',True)]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No buyer companies to verify yet.
            </p>
        </field>
    </record>

    <!-- Top-level Marketplace menu (creates it if missing) -->
    <menuitem id="menu_marketplace_root"
              name="Marketplace"
              sequence="90"
              groups="medical_marketplace.group_marketplace_admin"/>

    <!-- Sub-menu: Company Verification -->
    <menuitem id="menu_partner_verification"
              name="Company Verification"
              parent="menu_marketplace_root"
              action="action_partner_verification"
              sequence="10"
              groups="medical_marketplace.group_marketplace_admin"/>


    <!-- Partner form: verification fields -->
    <record id="view_partner_form_medical" model="ir.ui.view">
        <field name="name">res.partner.form.medical</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="registration_number"/>
                <field name="is_verified"/>
                <field name="verification_status"/>
            </xpath>
        </field>
    </record>

</odoo>
